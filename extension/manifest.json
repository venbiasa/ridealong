{
  "manifest_version": 3,
  "name": "ridealong",
  "version": "0.1.0",
  "description": "Let a local tool read a browser-gated service (IAP, SSO, ZTNA) through your own signed-in session. No credentials leave the browser.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/pair*"
      ],
      "js": [
        "pair-content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
